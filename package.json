{
  "name": "play-console-utils",
  "version": "0.0.1",
  "description": "Quick-reply and review-parsing shortcuts for the Google Play Console.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "@wxt-dev/storage": "^1.2.8",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8",
    "wxt": "^0.20.27"
  }
}
